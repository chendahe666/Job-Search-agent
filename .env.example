# Copy to .env and fill in. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Generation model (Settings → "Test connection" lists the models your key can use)
GEMINI_MODEL=gemini-3.8-flash
# Embeddings for RAG (falls back to local hashing vectors if unavailable)
GEMINI_EMBED_MODEL=gemini-embedding-001
