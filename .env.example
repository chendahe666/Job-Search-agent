# Copy this file to .env and add your key. Never commit the real .env file.
# 1. Google Gemini API (Recommended - Free Tier: 15 RPM, 1M TPM at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq Cloud API (Optional alternative)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
